# ==============================================================================
# Vaan Vibes Cafe & Restro Backend — Environment Configuration Template (.env.example)
# ==============================================================================

# Application Metadata & Server Settings
PROJECT_NAME="Vaan Vibes Cafe & Restro Backend"
API_V1_STR="/api/v1"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False
HOST="0.0.0.0"
PORT=9000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@localhost:5432/vaan_vibes_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration (Cache & Realtime PubSub)
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Security, HMAC & JWT Authentication
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CAFE_ID="van-vibes"
CAFE_SECRET_KEY="your-cafe-hmac-key"

# Frontend URLs & Dynamic QR Resolution
# Leave CUSTOMER_FRONTEND_URL empty ("") for automatic VPS IP / domain detection.
# Set only if using a fixed custom domain (e.g. "https://menu.vaanvibes.cafe")
CUSTOMER_FRONTEND_URL=""
MANAGEMENT_FRONTEND_URL="http://localhost:4001"

# CORS & Host Whitelist (Allows all incoming origins dynamically)
BACKEND_CORS_ORIGINS="*"
ALLOWED_HOSTS="*"
CORS_ALLOW_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL="INFO"
LOG_CONSOLE=true
