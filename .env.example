PROJECT_NAME="Vaan Vibes Cafe & Restro Backend"
ENVIRONMENT="production"
DEBUG=False
HOST="0.0.0.0"
PORT=9000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+psycopg2://postgres:postgrespassword@localhost:5432/vaan_vibes_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Security & JWT Auth
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CAFE_SECRET_KEY="your-cafe-hmac-key"

# Frontend URLs & CORS
CUSTOMER_FRONTEND_URL="http://84.247.143.242:4000"
MANAGEMENT_FRONTEND_URL="http://localhost:4001"
BACKEND_CORS_ORIGINS="http://localhost:4000,http://localhost:4001,http://127.0.0.1:4000,http://127.0.0.1:4001"
ALLOWED_HOSTS="*"

# Logging
LOG_LEVEL=INFO
LOG_CONSOLE=true
