# ==============================================================================
# Vaan Vibes Cafe & Restro Backend — Environment Configuration (.env.example)
# ==============================================================================

# Application Metadata & Server Settings
PROJECT_NAME="Vaan Vibes Cafe & Restro Backend"
API_V1_STR="/api/v1"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=9000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+psycopg2://localhost:5432/vaan_vibes_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration (Cache & Realtime PubSub)
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST="localhost"
REDIS_PORT=6379

# Security, HMAC & JWT Authentication
SECRET_KEY="vaan_vibes_super_secret_jwt_key_2026_production_grade"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
CAFE_ID="van-vibes"
CAFE_SECRET_KEY="vv_cafe_standee_hmac_secret_2026"

# Cafe Branding & Identity
CAFE_NAME="Vaan Vibes Cafe & Restro"
CAFE_HINDI_NAME="वन VIBES"
CAFE_TAGLINE="Cafe & Restro • Taste the Vibe"
CAFE_ADDRESS="Main Promenade, Serenita Arts Quarter, Surat, Gujarat - 395007"
CAFE_PHONE="+91 98765 43210"
CAFE_GSTIN="24AAAAA0000A1Z5"
CAFE_EMAIL="hello@vaanvibes.cafe"
CAFE_ORDERS_EMAIL="orders@vaanvibes.cafe"
CAFE_HOURS="10:00 AM - 03:30 PM, 05:30 PM - 11:30 PM"
CAFE_MORNING_HOURS="10:00 AM - 03:30 PM"
CAFE_BREAK_HOURS="03:30 PM - 05:30 PM"
CAFE_EVENING_HOURS="05:30 PM - 11:30 PM"
CAFE_CUISINES="Artisanal Coffee, Contemporary Indian, Gourmet Continental, Beverages & Mocktails, Desserts & Bakery"
CAFE_TAX_RATE=0.05
CAFE_CURRENCY="₹"

# Frontend URLs & Dynamic QR Resolution
# Leave CUSTOMER_FRONTEND_URL empty ("") for automatic VPS IP / domain detection.
# Set only if using a fixed custom domain (e.g. "https://menu.vaanvibes.cafe")
CUSTOMER_FRONTEND_URL=""
MANAGEMENT_FRONTEND_URL="http://localhost:4001"

# CORS & Host Whitelist (Allows all incoming origins dynamically)
BACKEND_CORS_ORIGINS="*"
ALLOWED_HOSTS="*"
CORS_ALLOW_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL="INFO"
LOG_CONSOLE=true
